# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# The template carries names only, never values.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# design skills, cloned from their own repos
/.claude/skills/

# The Claude Code originals the prompts in src/prompts/ were ported from. They
# are written for one person and carry a real name, handle, sites and salary
# floor; this repo is public under MIT. The port is the artefact, not the source.
/.claude/agents/
/.claude/commands/

# playwright mcp scratch output
/.playwright-mcp/
