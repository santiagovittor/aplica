{
  "name": "aplica",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "parse:cv": "node --env-file-if-exists=.env.local --experimental-transform-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve.mjs scripts/parse-cv.mts",
    "apply": "node --env-file-if-exists=.env.local --experimental-transform-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./scripts/ts-resolve.mjs scripts/apply.mts",
    "test:e2e": "node --env-file-if-exists=.env.local node_modules/@playwright/test/cli.js test",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@formkit/auto-animate": "^0.10.0",
    "@number-flow/react": "^0.6.2",
    "@react-pdf/renderer": "^4.5.1",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.111.0",
    "docx": "^9.7.1",
    "motion": "^12.42.2",
    "next": "16.2.11",
    "next-intl": "^4.13.4",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "rough-notation": "^0.5.1",
    "unpdf": "^1.8.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "supabase": "^2.109.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
