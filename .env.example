# Copy to .env.local and fill in. .env.local is gitignored; never commit values.

# Printed by `npx supabase start`. The publishable key is safe in the browser:
# it carries no privileges of its own, row-level security does the protecting.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only. Bypasses row-level security, so it is the only thing that can
# reach public.api_keys. Never import this into a client component.
SUPABASE_SECRET_KEY=

# 32 random bytes, base64. Encrypts each user's model API key at rest
# (PROJECT.md section 6). Losing it makes every stored key undecryptable, which
# is recoverable: users re-paste. Leaking it exposes every stored key.
# Generate your own, do not let a tool generate it into a log or a transcript:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
API_KEY_ENCRYPTION_KEY=

# Self-hosters only, and only if you point a custom endpoint at something on
# your own machine or network (Ollama on localhost, a vLLM box on a LAN
# address). It switches off the SSRF guard on the openai_compatible base URL:
# https-only, no loopback, no private or link-local addresses, no cloud
# metadata (PROJECT.md section 6). Leave it unset in anything internet-facing.
# Set to exactly `true` to enable; any other value is off.
ALLOW_PRIVATE_PROVIDER_HOSTS=

# Only needed once Google sign-in is switched on in supabase/config.toml.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
